# Copy this file to .env.local and adjust for your local setup.

# Base URL of sales-workflow-api. Defaults to the local dev server.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Base URL of the WebSocket transport (events/routing.py). Same host as
# above, ws(s):// instead of http(s)://.
VITE_WS_BASE_URL=ws://127.0.0.1:8000
